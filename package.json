    "migrate:status": "node scripts/migrate.mjs status",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.17.0",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
