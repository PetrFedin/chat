{
  "name": "chat-work-management",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "test": "node --test",
    "test:p0": "node --test test/p0-postgres-api.test.js test/p0-browser-postgres.test.js",
    "demo": "DEMO_MODE=true node src/server.js",
