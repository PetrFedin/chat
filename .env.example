# Скопируйте в .env и заполните. Пустые значения — это выключенная
# возможность, а не поломка: приложение о каждой скажет прямым текстом.

# Обязательное
POSTGRES_PASSWORD=
# 32 случайных байта в base64: openssl rand -base64 32
# Потеряете — пароли в сейфе не восстановить ничем.
VAULT_KEY=

# Необязательное
# Куда ходят тесты. Отдельно от DATABASE_URL, чтобы прогон не пошёл по
# рабочей базе; без неё треть набора молча пропускается.
POSTGRES_TEST_URL=
# Прежний ключ — только на время смены: пока идёт переписывание, часть
# строк запечатана им. Порядок в scripts/rotate-vault-key.mjs.
VAULT_KEY_PREVIOUS=
# Адрес, по которому пространство открывается снаружи. Нужен ссылкам в
# письмах: без него в сводке будет «/», и она никуда не приведёт.
PUBLIC_URL=
POSTGRES_USER=chat
POSTGRES_DB=chat
PORT=3000

# Почта: без неё приглашения и сброс пароля передаются руками
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=ChatX
# Свой почтовый сервер внутри компании: сертификат его удостоверяющего
# центра, строкой в PEM. Проверку подлинности не отключить — по этому
# соединению уходит пароль от ящика.
MAIL_CA=

# Push-уведомления: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Звонки и разбор совещаний
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# true — только если перед приложением действительно стоит обратный
# прокси: иначе клиент сможет подделать свой адрес заголовком.
TRUST_PROXY=false

# --- Безопасность и наблюдаемость ---
# Токен для /metrics и подробного /healthz в production: curl -H "Authorization: Bearer <токен>" …
METRICS_TOKEN=
# Адрес приложения снаружи (https://chat.example.com): из него собираются ссылки в письмах про
# сброс пароля и приглашения. Без него адрес берётся из заголовка Host, а это небезопасно.
# PUBLIC_URL=

# --- Хранилище файлов (по умолчанию том /data) ---
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Итоги встреч и ИИ (включаются только явно) ---
# LIVEKIT_EGRESS_ENABLED=true
# MEETING_TRANSCRIPTION_PROVIDER=openai
# MEETING_SUMMARY_PROVIDER=openai
# OPENAI_API_KEY=
# CHAT_ASSISTANT_PROVIDER=openai
