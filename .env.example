# ─── Core ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Without DATABASE_URL the server uses the in-memory store and loses all data
# on restart. Apply db/migrations/001..013 in order before first use.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat
# PG_POOL_MAX=10
# PGSSL=require

# ─── Demo workspace ──────────────────────────────────────────────────────────
# Seeds the Northstar Studio preview tenant. Never enable in production.
# DEMO_MODE=true

# ─── Authentication throttling ───────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_PER_IP=20
AUTH_RATE_LIMIT_MAX_PER_IDENTITY=6
# Set only when a proxy you control rewrites X-Forwarded-For. Left false, the
# header is ignored and the limiter keys on the real socket address, because a
# client can otherwise rotate the header and skip the per-address limit.
TRUST_PROXY=false

# ─── Embedding ───────────────────────────────────────────────────────────────
# Every embed is denied unless this names allowed ancestors, e.g.
# CSP_FRAME_ANCESTORS="'self' https://portal.example.com"
# CSP_FRAME_ANCESTORS=

# ─── Object storage ──────────────────────────────────────────────────────────
# Local disk is used when S3_BUCKET is unset. Ephemeral hosting may wipe it on
# redeploy, so production needs S3-compatible storage.
# UPLOAD_DIR=./data/uploads
# S3_BUCKET=chat-production
# S3_REGION=ru-1
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ─── LiveKit (audio/video calls) ─────────────────────────────────────────────
# Calls answer MEDIA_PROVIDER_UNAVAILABLE until these are set.
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_EGRESS_ENABLED=true
# LIVEKIT_TRANSCRIPTION_EGRESS_ENABLED=false

# ─── Meeting Intelligence providers ──────────────────────────────────────────
# Fail-closed: an API key alone enables nothing, the provider must be named.
# OPENAI_API_KEY=
# MEETING_TRANSCRIPTION_PROVIDER=openai
# MEETING_SUMMARY_PROVIDER=openai
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# OPENAI_MEETING_SUMMARY_MODEL=gpt-5.6
# OPENAI_MEETING_SUMMARY_REASONING=low
# MEETING_TRANSCRIPTION_LANGUAGE=ru
# MEETING_TRANSCRIPTION_TIMEOUT_MS=180000
# MEETING_SUMMARY_TIMEOUT_MS=180000

# ─── Meeting worker ──────────────────────────────────────────────────────────
MEETING_WORKER_ENABLED=true
MEETING_WORKER_POLL_MS=1500
MEETING_WORKER_PROVIDER_WAIT_MS=30000
MEETING_WORKER_SHUTDOWN_MS=5000
MEETING_PROCESSING_MAX_IN_MEMORY_BYTES=67108864

# ─── Outbound integrations ───────────────────────────────────────────────────
# Delivers outbox events to subscribed endpoints, signed with HMAC-SHA256.
# Requires DATABASE_URL; without it the integration API answers 503.
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_WORKER_POLL_MS=2000
WEBHOOK_WORKER_BATCH=10
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_LEASE_MS=30000

# ─── Web Push ────────────────────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
